# Comma-separated browser origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Broker shared with the Celery worker in apps/worker; must be the same instance
CELERY_BROKER_URL=redis://localhost:6379/0

# PostgreSQL is the only application database. Must match the worker's value.
# Local PostgreSQL 16 (the services create the jobs table if it is missing):
DATABASE_URL=postgresql://rivet:rivet@localhost:5432/rivet
# AWS RDS PostgreSQL later; only this value changes:
# DATABASE_URL=postgresql://rivet:PASSWORD@rivet-db.xxxx.us-east-1.rds.amazonaws.com:5432/rivet?sslmode=require

# No DEEPSEEK_* here on purpose: the API never calls the model. The worker in
# apps/worker owns the key, model and upstream URL (see apps/worker/.env.example).
