# Comma-separated browser origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL is the only application database. Must match the worker's value.
# Local PostgreSQL 16 (the services create the jobs table if it is missing):
DATABASE_URL=postgresql://rivet:rivet@localhost:5432/rivet
# AWS RDS PostgreSQL later; only this value changes:
# DATABASE_URL=postgresql://rivet:PASSWORD@rivet-db.xxxx.us-east-1.rds.amazonaws.com:5432/rivet?sslmode=require

# Connections each process holds open and may open at peak. Same names and
# defaults in the worker; every instance opens its own pool.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8

# SQS queue the worker polls. Must be the worker's SQS_QUEUE_URL.
# On AWS this comes from the environment/Terraform output; there is no default,
# because with no queue the API cannot start a job at all.
SQS_QUEUE_URL=
# LocalStack: http://localhost:4566/000000000000/rivet-jobs
# For a real queue: https://sqs.us-east-1.amazonaws.com/123456789012/rivet-jobs

# Region for the SQS client (boto3 needs one; IAM role provides the credentials)
AWS_REGION=us-east-1

# Only for LocalStack/http endpoints. Leave empty in production.
SQS_ENDPOINT_URL=
# SQS_ENDPOINT_URL=http://localhost:4566

# No DEEPSEEK_* here on purpose: the API never calls the model. The worker in
# apps/worker owns the key, model and upstream URL (see apps/worker/.env.example).
