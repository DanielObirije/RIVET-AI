# copied from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional, defaults to deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# Broker shared with apps/api; must point at the same instance
CELERY_BROKER_URL=redis://localhost:6379/0

# PostgreSQL is the only application database. Must match the API's value.
DATABASE_URL=postgresql://rivet:rivet@localhost:5432/rivet
# AWS RDS PostgreSQL later; only this value changes:
# DATABASE_URL=postgresql://rivet:PASSWORD@rivet-db.xxxx.us-east-1.rds.amazonaws.com:5432/rivet?sslmode=require
