# copied from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional, defaults to deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# PostgreSQL is the only application database. Must match the API's value.
DATABASE_URL=postgresql://rivet:rivet@localhost:5432/rivet
# AWS RDS PostgreSQL later; only this value changes:
# DATABASE_URL=postgresql://rivet:PASSWORD@rivet-db.xxxx.us-east-1.rds.amazonaws.com:5432/rivet?sslmode=require

# Connections each process holds open and may open at peak. Every worker
# instance opens its own pool, so total RDS connections grow with instances.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8

# SQS queue the API publishes to. Must be the API's SQS_QUEUE_URL.
# LocalStack: http://localhost:4566/000000000000/rivet-jobs
# For a real queue: https://sqs.us-east-1.amazonaws.com/123456789012/rivet-jobs
SQS_QUEUE_URL=

# Region for the SQS/S3 clients; credentials come from the IAM role on AWS, or
# from AWS_PROFILE / AWS_ACCESS_KEY_ID locally.
AWS_REGION=us-east-1

# Long poll: how long one receive may wait, and how long a job stays invisible.
# The visibility timeout must be longer than a DeepSeek request (40s).
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=120
# Keep at 1: a second message would sit visible while the first one runs.
SQS_MAX_MESSAGES=1

# Only for LocalStack/http endpoints. Leave both empty in production.
SQS_ENDPOINT_URL=
# SQS_ENDPOINT_URL=http://localhost:4566
S3_ENDPOINT_URL=
# S3_ENDPOINT_URL=http://localhost:4566

# S3 bucket for generated assets. No bucket is created by this application and
# nothing public is granted. Leave empty until an asset feature exists.
S3_BUCKET_NAME=
S3_REGION=us-east-1
